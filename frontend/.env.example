# Backend REST API base URL (e.g. https://synthleak-backend.onrender.com). Empty = same origin Vite proxy.
VITE_API_BASE_URL=

# Full WebSocket stream URL (e.g. wss://synthleak-backend.onrender.com/ws/stream). Empty = same origin /ws/stream.
VITE_WS_STREAM_URL=

# Optional Map Tile Configuration:
# By default, SynthLeak uses OpenStreetMap with a dark cyber-industrial CSS filter (100% free, zero API key required).
# If you wish to use authenticated CartoDB Dark Matter tiles without watermarks:
VITE_CARTO_API_KEY=

# Or supply an arbitrary custom tile URL template (e.g. Mapbox, MapTiler, Stadia):
VITE_MAP_TILES_URL=
